# ==============================================================================
# CSG-LMS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or input these environment variables
# directly into your Dokploy / Hetzner Cloud environment variable manager.
#
# IMPORTANT: Generate secure random strings for all secrets using:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DOMAIN & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
LEARNHOUSE_ENV=production
LEARNHOUSE_SITE_NAME="CSG-LMS Enterprise"
LEARNHOUSE_SITE_DESCRIPTION="Next-Generation Enterprise Learning Management System"
LEARNHOUSE_URL=https://app.csginfotech.com
LEARNHOUSE_API_URL=https://api.csginfotech.com
LEARNHOUSE_COLLAB_URL=https://collab.csginfotech.com
LEARNHOUSE_AUTH_URL=https://auth.csginfotech.com
LEARNHOUSE_PORT=9000
WORKERS=4

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 & PGVECTOR CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=learnhouse
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD_32_CHARS
POSTGRES_PORT=5432
# Async connection string for FastAPI / asyncpg
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://learnhouse:CHANGE_ME_SECURE_POSTGRES_PASSWORD_32_CHARS@postgres:5432/learnhouse
# Max startup retry attempts during cold start
LEARNHOUSE_DB_STARTUP_ATTEMPTS=10

# ------------------------------------------------------------------------------
# 3. REDIS 7.2 CACHE & SESSION STORE
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_32_CHARS
REDIS_PORT=6379
LEARNHOUSE_REDIS_URL=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_32_CHARS@redis:6379/0
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://:CHANGE_ME_SECURE_REDIS_PASSWORD_32_CHARS@redis:6379/0

# ------------------------------------------------------------------------------
# 4. KEYCLOAK 24 / 26 OIDC AUTHENTICATION
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_SECURE_KEYCLOAK_ADMIN_PASSWORD_32_CHARS
KEYCLOAK_HOSTNAME=auth.csginfotech.com
KEYCLOAK_PORT=8080

# Keycloak Realm & Client Settings used by FastAPI Token Verifier
KEYCLOAK_URL=https://auth.csginfotech.com
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=csg-lms
KEYCLOAK_CLIENT_ID=csg-lms-api
KEYCLOAK_CLIENT_SECRET=csg_lms_api_client_secret_token_change_in_production
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/csg-lms/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://auth.csginfotech.com/realms/csg-lms
KEYCLOAK_VERIFY_SIGNATURE=true
KEYCLOAK_ALGORITHMS=RS256

# ------------------------------------------------------------------------------
# 5. SECURITY KEYS & TOKENS
# ------------------------------------------------------------------------------
# Symmetric JWT Secret Key (Fallback / Internal verification)
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MINIMUM_64_CHARS
AUTH_JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MINIMUM_64_CHARS

# Internal API Secret between Collab Hocuspocus server and FastAPI backend
COLLAB_INTERNAL_KEY=CHANGE_ME_COLLAB_INTERNAL_KEY_MINIMUM_32_CHARS

# Media Share / Download Token Encryption Secret
LEARNHOUSE_MEDIA_SECRET_KEY=CHANGE_ME_MEDIA_SECRET_KEY_32_CHARS

# Super Admin Initial API Token (Optional)
LEARNHOUSE_SUPERADMIN_API_TOKEN=CHANGE_ME_INITIAL_SUPERADMIN_BEARER_TOKEN

# ------------------------------------------------------------------------------
# 6. NEXT.JS 15 FRONTEND (CLIENT-SIDE PUBLIC VARIABLES)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.csginfotech.com
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://api.csginfotech.com
NEXT_PUBLIC_LEARNHOUSE_COLLAB_URL=wss://collab.csginfotech.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.csginfotech.com
NEXT_PUBLIC_KEYCLOAK_REALM=csg-lms
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=csg-lms-web

# ------------------------------------------------------------------------------
# 7. COLLABORATION SERVICE (HOCUSPOCUS CRDT)
# ------------------------------------------------------------------------------
COLLAB_PORT=4000
COLLAB_TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 8. AI ENGINE & LLM PROVIDER API KEYS
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini, text-embedding-3-small)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (Gemini 1.5 Pro, Flash)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI (Mistral Large, Codestral)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (Llama 3.3 70B Fast Inference)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Local Self-Hosted LLM (Optional)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE / S3 / CDN (FILE ATTACHMENTS & MEDIA)
# ------------------------------------------------------------------------------
LEARNHOUSE_STORAGE_TYPE=s3api # Options: local, s3api
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com # Or AWS/MinIO
S3_REGION=auto
S3_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET_NAME=csg-lms-storage
S3_PUBLIC_DOMAIN=https://cdn.csginfotech.com

# ------------------------------------------------------------------------------
# 10. EMAIL & TRANSACTIONAL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend API (Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=notifications@csginfotech.com
EMAIL_FROM_NAME="CSG-LMS Notifications"

# Standard SMTP (Alternative)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@csginfotech.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_TLS=true

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & ERROR MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxxxxxx@o450000.ingest.sentry.io/450000
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@o450000.ingest.sentry.io/450000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# 12. BILLING & PAYMENTS (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
