# The CI build context is ./apps/api, so Docker reads this file and not the one at
# the repo root. Without it a local build copies .venv over the image's own venv,
# and ships .env into the image.

# Virtualenv - would clobber the venv built by `uv sync`
.venv
venv

# Python caches
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Test and coverage artifacts
.coverage
htmlcov

# Secrets and local config
.env
.env.*
**/.env
**/.env.*

# Node - not used by the Python image
node_modules

# VCS and editor
.git
.gitignore
.DS_Store

# Runtime output
logs

# Dev-only tooling - must not ship in the production image.
# scripts/mint_dev_keycloak_token.py mints a Keycloak-shaped JWT for an
# arbitrary role (including SUPER_ADMIN); with `docker exec` in a production
# container that is identity forgery with no session at all. Nothing in the
# build or in docker-entrypoint.prod.sh uses scripts/ (migrations run via
# `alembic upgrade head`), so excluding it is safe.
scripts
