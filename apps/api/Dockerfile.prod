# syntax=docker/dockerfile:1.4
# ==============================================================================
# CSG-LMS API Production Dockerfile
# Optimized Multi-Stage Build with UV package manager, Python 3.14/3.12,
# Non-root user execution, Bytecode pre-compilation, and healthcheck.
# ==============================================================================

# ── Stage 1: Dependency Builder ───────────────────────────────────────────────
FROM python:3.14.7-alpine3.24 AS builder

# System build dependencies for C-extensions (psycopg2, argon2, cryptography, etc.)
RUN apk upgrade --no-cache \
    && apk add --no-cache \
        gcc \
        musl-dev \
        libffi-dev \
        postgresql-dev \
        ffmpeg \
        netcat-openbsd \
        curl \
        bash \
        libstdc++ \
        build-base

# Copy Astral UV binary
COPY --from=ghcr.io/astral-sh/uv:0.10.7 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Step 1: Copy lockfiles and build isolated virtualenv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-cache

# Step 2: Copy application code
COPY . /app

# Handle public vs enterprise modules
ARG LEARNHOUSE_PUBLIC=false
RUN if [ "$LEARNHOUSE_PUBLIC" = "true" ]; then rm -rf /app/ee; fi

# Step 3: Final lockfile sync and package installation
RUN uv sync --frozen --no-dev --no-cache

# ── Stage 2: Production Distroless/Minimal Runner ─────────────────────────────
FROM python:3.14.7-alpine3.24 AS runner

LABEL maintainer="CSG Infotech <devops@csginfotech.com>" \
      application="CSG-LMS API" \
      version="1.3.6"

# Runtime shared libraries only
RUN apk upgrade --no-cache \
    && apk add --no-cache \
        curl \
        netcat-openbsd \
        ffmpeg \
        bash \
        libstdc++ \
        libpq \
    && rm -rf /var/cache/apk/*

# Security: Create non-privileged system user & group (UID: 10001, GID: 10001)
RUN addgroup -g 10001 -S appgroup \
    && adduser -u 10001 -S appuser -G appgroup -s /bin/bash

WORKDIR /app

# Copy virtual environment and application code from builder
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appgroup /app /app

# Ensure entrypoint is executable
RUN chmod +x /app/docker-entrypoint.prod.sh /app/docker-entrypoint.sh 2>/dev/null || true

# Set environment paths so virtualenv binaries (uvicorn, alembic, python) are primary
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    LEARNHOUSE_PORT=9000 \
    HOSTNAME=0.0.0.0

# Switch to non-root user
USER appuser

EXPOSE 9000

# Health Check Probe
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:9000/api/v1/health || curl -f http://localhost:9000/ || exit 1

ENTRYPOINT ["/app/docker-entrypoint.prod.sh"]
